---
// LISTA DE TODOS OS PROJETOS (/pt/projects/ etc.), do mais recente ao mais antigo.
import Base from '../../../layouts/Base.astro';
import ProjectList from '../../../components/ProjectList.astro';
import { langCodes, type Lang } from '../../../site.config';
import { useTranslations } from '../../../i18n/ui';
import { getProjects } from '../../../lib/content';

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const projects = await getProjects(lang);
---

<Base lang={lang} title={t('projects.title')} description={t('projects.description')}>
  <div class="wrap">
    <header class="page-head">
      <h1>{t('projects.title')}</h1>
      <p class="page-head__lead">{t('projects.description')}</p>
    </header>
    <ProjectList projects={projects} lang={lang} heading="h2" />
  </div>
</Base>
